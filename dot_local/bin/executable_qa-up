#!/usr/bin/env ruby
# frozen_string_literal: true

# qa-up — bring up, swap, or tear down a remote-devbox QA session for a payaus worktree.
#
# Creates a detached zellij session `qa` with four tabs:
#   tunnel  — bin/tunnel <worktree>
#   server  — bin/dev server   (waits for the tunnel's initial sync)
#   worker  — bin/dev worker   (waits for the server to respond)
#   webpack — bin/dev webpack  (waits for the server to respond)
#
# Each tab runs a supervisor rather than the command itself, so pointing qa-up at another
# worktree restarts only what that change actually invalidates — usually just the tunnel,
# because the containers bind-mount the synced directory and Rails reloads from it. The
# session, its tabs and their scrollback live across a swap.
#
# All devbox logic stays in bin/tunnel and bin/dev; this script only
# orchestrates zellij and polls files/URLs for readiness.

require "English"
require "fileutils"
require "json"
require "open3"
require "optparse"

CACHE = File.expand_path("~/.cache/qa-up")
STATE_FILE = File.join(CACHE, "state.json")
LOCK_FILE = File.join(CACHE, "lock")
LAYOUT_FILE = File.join(CACHE, "layout.kdl")
# One session, whatever it currently serves. The worktree lives in state.json and in the
# tab bar instead: a name that moves with the worktree goes stale inside every pane that
# already read $ZELLIJ_SESSION_NAME, and leaves the old name behind as resurrectable —
# which the next run would then tear down as if it were a second session.
SESSION = "qa"
# Single-region developer; stated once so the pgrep pattern, ssh config, and app
# domain can't drift apart. Make it env-derived if this ever goes multi-region.
REGION = "apac"
DEVELOPER = "jaredsharplin"
# Matches either syncer bin/tunnel can run — entangler, or pylon under
# --experimental-syncer. Mirrors bin/tunnel's own pattern so the two can't
# disagree about what counts as a tunnel already syncing to this region.
SYNCER_PGREP = "(entangler|pylon sync).*payaus_dev_config_#{REGION}".freeze
SSH_CONFIG = File.expand_path("~/.ssh/payaus_dev_config_#{REGION}")
APP_URL = "https://#{DEVELOPER}.dev.#{REGION}.adnat.co".freeze
ROLES = %w[tunnel server worker webpack].freeze
# The app containers bin/dev server/worker/webpack start on the box. They outlive
# their ssh ttys, so teardown and switching must stop them explicitly.
REMOTE_APP_CONTAINERS = %w[rails payaus-dev-job-work webpack].freeze

SYNC_TIMEOUT = 900
# Remote bundle/yarn + app-image pull + boot + first HTTP response.
SERVER_TIMEOUT = 1800
# webpack's first compile of the full bundle; dev-middleware holds asset requests until done.
WEBPACK_TIMEOUT = 900
# Any bundle the login page needs works as the "assets are servable" probe.
ASSET_PROBE_URL = "#{APP_URL}/assets/webpack/application.js".freeze
BRINGUP_TIMEOUT = SYNC_TIMEOUT + SERVER_TIMEOUT
# Escalation order for stopping a syncer, and how long each signal gets to take effect
# before the next one. INT first because bin/tunnel's EXIT trap alerts on anything but
# 0 or 130 — see kill_tunnel!.
SYNCER_SIGNALS = %w[INT KILL].freeze
KILL_TUNNEL_GRACE = 5
# How often a role supervisor looks for its child dying or its generation moving. The
# whole cost of the supervisor is four processes stat-ing one file at this rate.
SUPERVISOR_TICK = 1
# How long a deliberately stopped child gets to go before the supervisor stops waiting.
CHILD_STOP_GRACE = 15

# Paths whose difference between two worktrees decides how much of a running session has
# to be rebuilt. Tier 2 first: these feed BUILD_LOCK_HASH in set-dev-env.sh, and compose.yml
# pins every service to ${IMAGE_NAME}:${BUILD_LOCK_HASH}, so a difference means the running
# containers are on the wrong image. Compared by content rather than by recomputing the
# hash, which word-splits through an unquoted echo and shells out to sha256sum.
IMAGE_PATHS = %w[
  Gemfile Gemfile.lock Dockerfile yarn.lock .ruby-version compose.yml
  useful_scripts/dev-tunnel/set-dev-env.sh
].freeze
# Tier 0 is a whitelist on purpose. A leaky whitelist costs a restart nobody needed; a
# leaky blacklist means QA silently passes against code that is not running. app/middleware
# is carved out because the stack is built once at boot and holds instances, so editing one
# reloads the class and changes nothing. lib is not autoloaded at all.
# Beyond app code: sorbet holds RBIs nothing requires at boot, and .buildkite, .github and
# .claude are CI and tooling config the running app never reads. Together they account for
# most of what a branch based on a different master drags along.
RELOADABLE_PATHS = %w[app test db/migrate docs sorbet .buildkite .github .claude].freeze
RELOAD_EXCEPTIONS = %w[app/middleware].freeze

# zellij derives its IPC socket path from $TMPDIR. The macOS default is long, and a
# background Claude task's $TMPDIR is longer still — either can exceed the ~103-byte
# AF_UNIX limit. Pin a short one so bring-up, teardown, and attach share one socket path.
ENV["TMPDIR"] = "/tmp"
# bin/tunnel prompts interactively for a developer name when neither .env nor $DEV_NAME
# has one; in a detached pane that read blocks forever. Supply it so the pane never stalls.
ENV["DEV_NAME"] = DEVELOPER
# Agent harnesses (e.g. Claude Code) export BROWSER=true — a shell no-op. Python's
# webbrowser honours $BROWSER first, so `aws sso login` in the tunnel pane would
# "open" its login page into nothing. The session must reach the developer's real
# browser; drop the no-op and let macOS pick the default.
ENV.delete("BROWSER") if ENV["BROWSER"] == "true"
# Flush milestone output promptly even when stdout is a pipe (e.g. the /qa skill).
$stdout.sync = true

def run(*args, allow_failure: false)
  stdout, stderr, status = Open3.capture3(*args)
  raise "#{args.join(" ")} failed: #{stderr.strip}" unless status.success? || allow_failure

  stdout.strip
end

# Worktrees share the main checkout's git dir, so --git-common-dir resolves to it from any of
# them and the path never has to be written down here. $PAYAUS_ROOT covers running from outside
# a checkout, which is where the fzf picker is reached from.
def payaus
  @payaus ||= ENV["PAYAUS_ROOT"] || payaus_from_cwd ||
    abort("Not in a payaus checkout, and PAYAUS_ROOT is unset.")
end

# The origin check keeps a run from some other repo out: git resolves a common dir there too,
# and without it qa-up would bring a QA session up against the wrong tree.
def payaus_from_cwd
  git_dir = run("git", "rev-parse", "--path-format=absolute", "--git-common-dir", allow_failure: true)
  return if git_dir.empty?

  root = File.dirname(git_dir)
  root if run("git", "-C", root, "remote", "get-url", "origin", allow_failure: true).include?("payaus")
end

def log_path(role) = File.join(CACHE, "#{role}.log")
def exit_path(role) = File.join(CACHE, "#{role}.exit")
# The generation a role is actually running, written after its child is spawned. Readers
# use it to tell this run's output from the run before it.
def gen_path(role) = File.join(CACHE, "#{role}.gen")
def pid_path(role) = File.join(CACHE, "#{role}.pid")

# Deliberately not memoized: a swap rewrites this file underneath the running supervisors,
# and a cached copy is exactly how a role would sleep through its own restart.
def state = JSON.parse(File.read(STATE_FILE), symbolize_names: true)

# Renamed into place, so no supervisor can catch it half-written.
def write_state(**attributes)
  FileUtils.mkdir_p(CACHE)
  incoming = "#{STATE_FILE}.incoming"
  File.write(incoming, JSON.pretty_generate(attributes))
  File.rename(incoming, STATE_FILE)
end

# Each role carries its own generation, so a swap can restart the tunnel while leaving the
# server and worker where they are simply by bumping one of them.
def target_generation(role) = state[:generations].fetch(role.to_sym)

def running_generation(role)
  File.read(gen_path(role)).strip.to_i if File.exist?(gen_path(role))
end

# qa-up runs from a terminal and, through the /qa skill, in the background at the same
# time. Two swaps interleaving their state writes would leave the roles on different
# worktrees, which is unrecoverable without a teardown.
def with_lock
  FileUtils.mkdir_p(CACHE)
  File.open(LOCK_FILE, File::CREAT | File::RDWR) do |lock|
    abort "another qa-up is running (#{LOCK_FILE} is held)." unless lock.flock(File::LOCK_EX | File::LOCK_NB)

    yield
  end
end

def worktrees
  run("git", "-C", payaus, "worktree", "list", "--porcelain")
    .split("\n\n")
    .filter_map { it[/^worktree (.+)$/, 1] }
end

def resolve_worktree(arg)
  return pick_worktree_by_name(arg) if arg

  toplevel = run("git", "rev-parse", "--show-toplevel", allow_failure: true)
  return toplevel if worktrees.include?(toplevel)

  pick_worktree_with_fzf
end

def pick_worktree_by_name(name)
  worktrees.find { File.basename(it) == name } ||
    abort("No worktree named '#{name}'. Run 'git worktree list' to see available worktrees.")
end

def pick_worktree_with_fzf
  abort "Not inside a payaus worktree, and no TTY for the fzf picker. Pass a worktree name." unless $stdout.tty?

  choices = worktrees.map { File.basename(it) }.join("\n")
  choice, _, status = Open3.capture3("fzf", "--prompt", "QA worktree> ", stdin_data: choices)
  abort "No worktree selected." unless status.success?

  pick_worktree_by_name(choice.strip)
end

# Includes sessions zellij keeps listed as resurrectable after a kill.
def qa_sessions
  stdout, _, status = Open3.capture3("zellij", "list-sessions", "--no-formatting")
  return [] unless status.success?

  stdout.split("\n").filter_map do |line|
    name = line.split.first
    # The "qa-<worktree>" form is what this script used to create; matching it too means a
    # session left over from that scheme gets torn down rather than orphaned.
    {name:, exited: line.include?("EXITED")} if name == SESSION || name&.start_with?("#{SESSION}-")
  end
end

def remove_session(name)
  run("zellij", "kill-session", name, allow_failure: true)
  run("zellij", "delete-session", "--force", name, allow_failure: true)
end

# The budget has to cover a cold connection, not a reused one: the ssh config's
# ControlMaster is often gone by teardown, and a fresh one is built by a ProxyCommand
# that talks to AWS first. Five seconds only ever succeeded when the master was warm.
def stop_remote_containers
  _, _, status = Open3.capture3("ssh", "-F", SSH_CONFIG, "-o", "ConnectTimeout=30", "devbox",
    "docker rm -f #{REMOTE_APP_CONTAINERS.join(" ")}")
  if status.success?
    puts "stopped remote app containers"
  else
    puts "could not reach devbox to stop app containers (the next bin/dev run replaces them)"
  end
end

def syncer_pids = `pgrep -f "#{SYNCER_PGREP}"`.split.map(&:to_i)

# Signalling is not the synchronisation point: bin/tunnel refuses to start while any
# syncer still reaches this region, and asks on stdin whether to stop it. In a detached
# pane that read never returns, so the caller has to wait for the pattern to go quiet
# rather than assume the signal landed.
#
# INT rather than TERM, because bin/tunnel traps EXIT and pops a critical macOS alert
# for any status but 0 or 130. A TERMed bash exits 143 and alerts on every teardown;
# 130 is the ctrl-c pylon documents, and it suppresses the alert.
def kill_tunnel!
  return if syncer_pids.empty?

  stopped = SYNCER_SIGNALS.any? do |signal|
    signal_tree(signal, syncer_pids)
    syncer_stopped_within?(KILL_TUNNEL_GRACE)
  end
  return if stopped

  abort "a syncer survived SIG#{SYNCER_SIGNALS.last} (#{syncer_pids.join(", ")}). Stop it by " \
        "hand — bin/tunnel blocks on a prompt while one is alive."
end

def syncer_stopped_within?(seconds)
  deadline = Time.now + seconds
  until syncer_pids.empty?
    return false if Time.now > deadline

    sleep 0.5
  end
  true
end

# One process at a time, never by process group. A role's child has to stay in its
# supervisor's group, because that group is the pane's foreground group — put it anywhere
# else and it takes SIGTTIN the moment bin/dev's ssh reads the terminal, and stops dead.
# That makes the group useless as a unit of killing, since the supervisor is in it.
def signal_tree(signal, pids)
  pids.flat_map { [it] + descendants_of(it) }.uniq.reverse_each { signal_quietly(signal, it) }
end

def descendants_of(pid)
  `pgrep -P #{pid}`.split.map(&:to_i).flat_map { [it] + descendants_of(it) }
end

def signal_quietly(signal, pid)
  Process.kill(signal, pid)
rescue Errno::ESRCH
  nil
end

# A swap only lands on a session whose supervisors are alive to notice the generation move.
# Anything else — no session, a resurrectable husk, a pane whose supervisor died — has to be
# built from scratch, because there is nothing running to take the instruction.
def swappable?
  live = qa_sessions.find { it[:name] == SESSION && !it[:exited] }
  live && File.exist?(STATE_FILE) && ROLES.all? { supervisor_alive?(it) }
end

def supervisor_alive?(role)
  return false unless File.exist?(pid_path(role))

  Process.kill(0, File.read(pid_path(role)).strip.to_i)
  true
rescue Errno::ESRCH, Errno::EPERM, ArgumentError
  false
end

# A role whose child exited stays down until something bumps it, so every swap carries the
# dead ones along with whatever its tier calls for. That is what makes "it will restart on
# the next swap" true.
def dead_roles = ROLES.select { File.exist?(exit_path(it)) }

# Order matters twice over. The containers go first, while the tunnel's ssh ControlMaster
# is still alive to carry the command — killing the syncer's process group takes the master
# with it. The syncer then goes before the panes, because zellij kill-session signals them
# with TERM and bin/tunnel's EXIT trap turns any status but 0 or 130 into a critical alert.
def teardown(sessions)
  stop_remote_containers
  kill_tunnel!
  sessions.each { remove_session(it[:name]) }
end

# Per-run logs and markers, cleared at bring-up and teardown so `status` never
# shows output from a run that's no longer live.
def clear_run_artifacts
  ROLES.each do |role|
    [log_path(role), exit_path(role), gen_path(role), pid_path(role)].each { FileUtils.rm_f(it) }
  end
end

def prepare_state(worktree_dir)
  FileUtils.mkdir_p(CACHE)
  clear_run_artifacts
  write_state(worktree: File.basename(worktree_dir), generations: ROLES.to_h { [it, 1] })
end

def write_layout
  qa_up = File.expand_path($PROGRAM_NAME)
  tabs = ROLES.map do |role|
    <<~KDL
      tab name="#{role}" cwd="#{payaus}" {
          pane command="#{qa_up}" {
              args "run" "#{role}"
          }
      }
    KDL
  end

  File.write(LAYOUT_FILE, "layout {\n#{tabs.join.gsub(/^/, "    ")}}\n")
end

def launch_session
  run("zellij", "attach", "--create-background", SESSION)
  run("zellij", "--session", SESSION, "--layout", LAYOUT_FILE)
end

def bring_up(worktree_dir)
  kill_tunnel!
  prepare_state(worktree_dir)
  write_layout
  launch_session
  puts "Launched #{SESSION} (tabs: #{ROLES.join(", ")} + scratch shell)"
  await_bring_up
end

def await_bring_up
  # Pylon re-hashes a tree whose inodes it does not recognise, which sounds expensive and is
  # not: ~39k files in a little over 4s, measured. So silence here still means trouble —
  # unless bin/tunnel just opened a browser SSO prompt that's awaiting approval.
  wait_for("tunnel sync", timeout: SYNC_TIMEOUT, failed_if_exited: %w[tunnel], hint_after: 45,
    hint: "this should be quick unless a browser SSO prompt is awaiting approval — " \
          "run `qa-up status` to see the tunnel tab; if the dev box is down, `bin/dev start`") do
    sync_ready?
  end
  puts "Tunnel synced — now booting the server (remote deps + boot take a few minutes; quiet is expected)."
  wait_for("server to respond", timeout: SERVER_TIMEOUT, failed_if_exited: %w[tunnel server]) { http_ready?(APP_URL) }
  puts "Server up — waiting for webpack to finish its first compile (assets hang until then)."
  wait_for("webpack assets", timeout: WEBPACK_TIMEOUT, failed_if_exited: %w[tunnel server webpack]) do
    http_ready?(ASSET_PROBE_URL)
  end
end

def announce(worktree_dir)
  branch = run("git", "-C", worktree_dir, "rev-parse", "--abbrev-ref", "HEAD")
  puts
  puts "Worktree: #{File.basename(worktree_dir)} (#{branch})"
  puts "App:      #{APP_URL}"
  puts "Session:  #{SESSION} (qa-up attach)"
  puts "Teardown: qa-up --down"
  puts
  puts "QA_READY url=#{APP_URL} session=#{SESSION}"
end

# --- readiness signals (shared by the foreground monitor and the pane gates) ---

# The supervisor empties each log before it spawns, so a marker found here belongs to the
# generation currently running. Memoize once seen — the file only grows while we wait — but
# key the memo by that generation, so a swap invalidates it rather than carrying a stale
# "ready" into the next run.
def log_reached?(role, marker)
  @log_reached ||= {}
  @log_reached["#{role}/#{running_generation(role)}/#{marker}"] ||=
    File.exist?(log_path(role)) && File.read(log_path(role)).include?(marker)
end

# Each syncer announces steady state in its own words: entangler mirrors "INFO: Ready!",
# pylon prints the ctrl-c hint beneath its ready line. Neither string is interpolated, and
# --brand leaves pylon's alone. Both are listed so a tunnel started without
# --experimental-syncer still reaches the gate.
SYNC_MARKERS = ["INFO: Ready!", "watching for changes, ctrl-c to stop"].freeze

# Only the tunnel's current generation counts. A swap empties tunnel.log and starts a new
# sync; the marker from the run before it must never satisfy this gate, or a swap reports
# itself complete before a single file has moved.
def sync_ready?
  return false unless running_generation("tunnel") == target_generation("tunnel")

  SYNC_MARKERS.any? { log_reached?("tunnel", it) }
end

def http_ready?(url)
  code, = Open3.capture3("curl", "-so", File::NULL, "-w", "%{http_code}", "--max-time", "5", url)
  code.match?(/^[23]/)
end

def wait_for(label, timeout:, failed_if_exited: [], hint: nil, hint_after: 60)
  started = Time.now
  hint_at = hint ? started + hint_after : nil
  until yield
    fail_if_pane_exited(failed_if_exited)
    elapsed = Time.now - started
    abort "Timed out after #{timeout}s waiting for #{label}." if elapsed > timeout
    if hint_at && Time.now > hint_at
      puts "still waiting for #{label} — #{hint}"
      hint_at = nil
    end
    sleep 2
  end
end

def fail_if_pane_exited(roles)
  role = roles.find { File.exist?(exit_path(it)) }
  abort_with_log_tail(role) if role
end

def abort_with_log_tail(role)
  tail = File.read(log_path(role)).split("\n").last(20).join("\n")
  abort "#{role} exited before QA came up. Last output:\n#{tail}"
end

# --- role supervisors (invoked by the zellij layout as `qa-up run <role>`) ---

# The supervisor never exits. It owns spawning, signalling and reaping its own child, so a
# swap is a number changing in state.json rather than an outside process signalling into a
# pane and a monitor trying to work out afterwards whether that was deliberate. The tab,
# its id, its position and its scrollback all survive a restart, and zellij's "press Enter
# to re-run" prompt now only ever appears when the supervisor itself has died.
def run_role(role)
  Dir.chdir(payaus)
  File.write(pid_path(role), Process.pid)
  loop { run_generation(role) }
end

def run_generation(role)
  generation = target_generation(role)
  await_gate(role)
  # Emptied before the spawn rather than left to tee, so that a reader seeing the new
  # generation can never also be seeing the previous run's output.
  File.write(log_path(role), "")
  # Deliberately in the supervisor's own process group — see signal_tree. The pane's
  # foreground group is the only place a child that talks to the terminal can run.
  child = Process.spawn("bash", "-o", "pipefail", "-c",
    "#{role_command(role)} 2>&1 | tee #{log_path(role)}")
  File.write(gen_path(role), generation.to_s)
  supervise(role, generation, child)
end

def role_command(role)
  case role
  when "tunnel" then "bin/tunnel --experimental-syncer #{state[:worktree]}"
  when "server", "worker", "webpack" then "bin/dev #{role}"
  else abort "Unknown role '#{role}'"
  end
end

def await_gate(role)
  case role
  when "server"
    gate(role, "tunnel sync", timeout: SYNC_TIMEOUT) { sync_ready? }
  when "worker", "webpack"
    # Wait for the server to actually serve HTTP, not just finish its deps step:
    # "Running server at" prints before the server's docker compose run pulls the
    # app image, and concurrent pulls of a missing image corrupt containerd's ingest.
    gate(role, "server to respond", timeout: BRINGUP_TIMEOUT) { http_ready?(APP_URL) }
  end
end

def supervise(role, generation, child)
  while target_generation(role) == generation
    child = nil if child && reaped?(role, child)
    sleep SUPERVISOR_TICK
  end
  stop_child(role, child) if child
end

# A child that exits on its own leaves its .exit marker and stays down — the pane keeps its
# supervisor, so the role comes back on the next swap instead of needing the session rebuilt.
def reaped?(role, child)
  finished, status = Process.wait2(child, Process::WNOHANG)
  return false unless finished

  File.write(exit_path(role), status.exitstatus.to_s)
  puts "#{role} exited with #{status.exitstatus} — it will restart on the next bring-up or swap"
  true
rescue Errno::ECHILD
  true
end

# INT for the reason kill_tunnel! uses it: bin/tunnel and bin/dev trap EXIT and alert on
# any status but 0 or 130.
def stop_child(role, child)
  terminate(child)
  # pylon can outlive the wrapper that started it, and bin/tunnel stops to ask a question
  # if any syncer still reaches this region when the next one starts.
  kill_tunnel! if role == "tunnel"
end

def terminate(child)
  signal_tree("INT", [child])
  deadline = Time.now + CHILD_STOP_GRACE
  until Process.wait2(child, Process::WNOHANG)
    signal_tree("KILL", [child]) if Time.now > deadline
    sleep SUPERVISOR_TICK
  end
rescue Errno::ECHILD
  nil
end

def gate(role, label, timeout:)
  started = Time.now
  next_heartbeat = 0
  until yield
    elapsed = (Time.now - started).to_i
    if elapsed > timeout
      File.write(exit_path(role), "1")
      abort "#{role}: timed out after #{timeout}s waiting for #{label}"
    end
    if elapsed >= next_heartbeat
      puts "#{role}: waiting for #{label}… (#{elapsed}s)"
      next_heartbeat = elapsed + 15
    end
    sleep 3
  end
end

# --- swapping the deployed worktree ---

# How much of a live session a worktree change costs. Committed differences come from git;
# uncommitted and untracked ones from each side's status, because the normal QA state is a
# tree with work in it. Gitignored files are invisible to both — of the ones that reach the
# box, only .env matters, and require_env_file covers it.
def restart_tier(changed)
  return :rebuild if changed.any? { IMAGE_PATHS.include?(it) }
  return :tunnel if changed.all? { reloadable?(it) }

  :app
end

def changed_paths(outgoing_dir, incoming_dir)
  committed = run("git", "-C", payaus, "diff", "--name-only",
    head_of(outgoing_dir), head_of(incoming_dir)).split("\n")
  (committed + dirty_paths(outgoing_dir) + dirty_paths(incoming_dir)).uniq
end

def head_of(worktree_dir) = run("git", "-C", worktree_dir, "rev-parse", "HEAD")

# Asked for as bare paths rather than parsed out of --porcelain, whose two status columns
# and leading space do not survive the strip in run, and whose rename entries carry two
# paths on one line.
def dirty_paths(worktree_dir)
  modified = run("git", "-C", worktree_dir, "diff", "--name-only", "HEAD")
  untracked = run("git", "-C", worktree_dir, "ls-files", "--others", "--exclude-standard")
  [modified, untracked].flat_map { it.split("\n") }.reject(&:empty?)
end

def reloadable?(path)
  return false if RELOAD_EXCEPTIONS.any? { path == it || path.start_with?("#{it}/") }

  RELOADABLE_PATHS.any? { path == it || path.start_with?("#{it}/") }
end

ROLES_BY_TIER = {tunnel: %w[tunnel], app: %w[tunnel server worker]}.freeze

def swap!(incoming_dir)
  outgoing = state[:worktree]
  incoming = File.basename(incoming_dir)
  changed = changed_paths(pick_worktree_by_name(outgoing), incoming_dir)
  tier = restart_tier(changed)
  return rebuild(incoming_dir, outgoing) if tier == :rebuild

  roles = ROLES_BY_TIER.fetch(tier) | dead_roles
  puts "Swapping #{outgoing} → #{incoming} (restarting: #{roles.join(", ")})"
  bump_generations(incoming, roles)
  await_swap(roles)
  report_migrations(changed)
end

# The single commit point of a swap: every supervisor takes its cue from this one write.
# The exit markers go first, so that nothing watching can see a role both restarting and
# still carrying the marker from the run that killed it.
def bump_generations(worktree, roles)
  generations = state[:generations]
  roles.each do |role|
    FileUtils.rm_f(exit_path(role))
    generations[role.to_sym] += 1
  end
  write_state(worktree:, generations:)
end

def await_swap(roles)
  roles.each do |role|
    wait_for("#{role} to pick up the swap", timeout: SYNC_TIMEOUT) do
      running_generation(role) == target_generation(role)
    end
  end
  wait_for("tunnel sync", timeout: SYNC_TIMEOUT, failed_if_exited: %w[tunnel]) { sync_ready? }
  return unless roles.include?("server")

  puts "Tunnel synced — the server is restarting for a config change."
  wait_for("server to respond", timeout: SERVER_TIMEOUT, failed_if_exited: %w[tunnel server]) do
    http_ready?(APP_URL)
  end
end

# Never gated on: the app raises PendingMigrationError on the next page load by itself
# (development.rb sets migration_error = :page_load), and asking the box costs a container
# and a full Rails boot to learn what the browser will tell you for nothing.
def report_migrations(changed)
  return if changed.none? { it.start_with?("db/migrate/") }

  puts "Migrations differ between the two worktrees — run `bin/dev migrate` if the app raises."
end

# The syncer mirrors this machine onto the box on its first cycle, deleting whatever the box
# has that the worktree doesn't. .env is gitignored, so it is per-worktree, and it is not one
# of the syncer's ignored paths — so syncing a worktree without one removes the box's copy.
#
# Nothing here creates it: bin/tunnel's check_developer_site_instance writes .env into
# $PAYAUS_DIR, which is the main checkout this script runs it from, never the worktree it
# is told to sync. Compose only reads the file to interpolate defaults it already has, so
# this is worth saying and not worth refusing over.
def warn_about_env(worktree_dir)
  return if File.exist?(File.join(worktree_dir, ".env"))

  puts "#{File.basename(worktree_dir)} has no .env, so the box's copy goes with this sync. " \
       "Compose falls back to its defaults; run bin/tunnel from inside that worktree once if " \
       "you need its own values."
end

def rebuild(incoming_dir, outgoing)
  puts "Swapping #{outgoing} → #{File.basename(incoming_dir)} needs a rebuild " \
       "(the image inputs differ), so this takes as long as a fresh bring-up."
  teardown(qa_sessions)
  bring_up(incoming_dir)
end

# --- teardown ---

def down!
  sessions = qa_sessions
  clear_run_artifacts
  if sessions.empty?
    kill_tunnel!
    puts "No QA session running."
    return
  end

  teardown(sessions)
  puts "killed #{sessions.map { it[:name] }.join(", ")}"
end

def status!
  sessions = qa_sessions
  if sessions.empty?
    puts "No QA session."
  else
    puts sessions.map { "session #{it[:name]}#{" (EXITED)" if it[:exited]}" }
    puts "serving #{state[:worktree]}" if File.exist?(STATE_FILE)
  end
  ROLES.each { puts "\n── #{it}#{role_state(it)} ──\n#{log_tail(it)}" }
end

def role_state(role)
  return " [exited #{File.read(exit_path(role)).strip}]" if File.exist?(exit_path(role))
  return " [no supervisor]" unless supervisor_alive?(role)

  ""
end

def log_tail(role)
  log = log_path(role)
  return "(no output yet)" unless File.exist?(log) && !File.empty?(log)

  File.readlines(log).last(12).join.rstrip
end

# --- main ---

if ARGV.first == "run"
  run_role(ARGV.fetch(1) { abort "Usage: qa-up run <role>" })
  exit
end

exec("zellij", "attach", SESSION) if ARGV.first == "attach"

if ARGV.first == "status"
  status!
  exit
end

options = {attach: $stdout.tty?}
OptionParser.new do |o|
  o.banner = "Usage: qa-up [worktree] [--down | attach | status] [--no-attach]"
  o.on("--down", "Tear down the QA session and tunnel") { options[:down] = true }
  o.on("--no-attach", "Do not attach to the zellij session when ready") { options[:attach] = false }
  o.on("-h", "--help") do
    puts o
    exit
  end
end.parse!

if options[:down]
  down!
  exit
end

worktree_dir = resolve_worktree(ARGV.first)

with_lock do
  warn_about_env(worktree_dir)
  if swappable?
    if state[:worktree] == File.basename(worktree_dir)
      puts "#{SESSION} is already serving #{state[:worktree]}. Attach with: qa-up attach"
      exit 0
    end
    swap!(worktree_dir)
  else
    teardown(qa_sessions)
    bring_up(worktree_dir)
  end
  announce(worktree_dir)
end

exec("zellij", "attach", SESSION) if options[:attach] && ENV["ZELLIJ"].nil?
