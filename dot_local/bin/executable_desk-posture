#!/bin/bash
# Sit/stand reminder, fired on the hour by the com.jaredsharplin.desk-posture launch agent.
# Workdays run 8:30-17:30 sitting first, alternating hourly, with lunch at 12 unprompted.
# System Events owns the alert so it takes keyboard focus: Return dismisses it.

(($(date +%u) <= 5)) || exit 0

case $(date +%-H) in
9 | 11 | 13 | 15 | 17) posture="Stand up" ;;
10 | 14 | 16) posture="Sit down" ;;
*) exit 0 ;;
esac

osascript -e "tell application \"System Events\"
  activate
  display alert \"$posture\" message \"Take a short walk first.\" buttons {\"OK\"} default button \"OK\"
end tell" >/dev/null
