#!/bin/bash
# Sit/stand reminder, fired on the hour by the com.jaredsharplin.desk-posture launch agent.
# Workdays run 8:30-17:30 sitting first, alternating hourly. Noon is a lunch walk with no reminder,
# and the afternoon starts again on sitting at 13:00.
# While the screen is locked (away, or a dark wake replaying a missed hour) the alert waits for
# the unlock, giving up at :55. An alert shown while locked never appears and blocks the next run.
# System Events owns the alert so it takes keyboard focus: Return dismisses it. An unanswered
# alert closes itself before the next hour's, and the wait outlasts it, since a timed-out
# AppleEvent leaves the alert on screen to stack under the next one.
# A dismissal within 2 seconds of showing is taken as a stray Return or click while typing, so the
# alert shows again. Each run logs to ~/.local/state/desk-posture.log.

(($(date +%u) <= 5)) || exit 0

case $(date +%-H) in
9 | 11 | 14 | 16) posture="Stand up" ;;
10 | 13 | 15 | 17) posture="Sit down" ;;
*) exit 0 ;;
esac

log_file="$HOME/.local/state/desk-posture.log"
mkdir -p "$(dirname "$log_file")"
log() { echo "$(date '+%F %T') $posture: $*" >>"$log_file"; }

log "fired"

while ioreg -n Root -d1 | grep -q CGSSessionScreenIsLocked; do
  if (($(date +%-M) >= 55)); then
    log "screen stayed locked, skipped"
    exit 0
  fi
  sleep 60
done

while :; do
  seconds_until_next_hour=$(((59 - $(date +%-M)) * 60))

  log "shown"
  shown_at=$SECONDS

  result=$(osascript -e "with timeout of 3600 seconds
    tell application \"System Events\"
      activate
      display alert \"$posture\" message \"Take a short walk first.\" buttons {\"OK\"} default button \"OK\" giving up after $seconds_until_next_hour
    end tell
  end timeout" 2>&1)

  seconds_shown=$((SECONDS - shown_at))

  case $result in
  *"gave up:true"*) log "unanswered, closed itself" ;;
  *"button returned:OK"*)
    if ((seconds_shown < 2)); then
      log "dismissed after ${seconds_shown}s, reshowing"
      continue
    fi
    log "dismissed after ${seconds_shown}s"
    ;;
  *) log "alert failed: $result" ;;
  esac
  break
done
