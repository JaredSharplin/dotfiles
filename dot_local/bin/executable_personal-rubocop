#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the personal cops in ~/.config/rubocop/personal.yml over the given Ruby
# files, or over the staged ones when called with no arguments or --staged.
#
# Runs through the project's own bundle, exactly as the project's own cops do.
# Only the config file differs: personal.yml is standalone and enables nothing
# but the Personal/ department, so this never duplicates or contradicts what the
# project already enforces. Reaching for a rubocop outside the bundle instead
# costs you every gem the project's .rubocop.yml requires — in payaus that means
# activesupport, which lives inside a git-sourced Rails and so is invisible to
# plain RubyGems.

require "open3"

CONFIG = File.expand_path("~/.config/rubocop/personal.yml")

# A project's rubocop server is keyed to its directory and caches the config it
# started with. Ours is a different config in the same directory, so stay out.
NO_SHARED_SERVER = "--no-server"

def staged_paths
  stdout, stderr, status = Open3.capture3(
    "git", "diff", "--cached", "--name-only", "--diff-filter=ACM", "-z"
  )
  abort "git diff failed: #{stderr.strip}" unless status.success?
  stdout.split("\0")
end

# The husky hook that calls this is sourced in every repo, most of which have no
# bundle to run rubocop through.
exit 0 unless File.exist?("Gemfile")

paths = (ARGV.empty? || ARGV == ["--staged"]) ? staged_paths : ARGV
files = paths.select { it.end_with?(".rb") && File.file?(it) }
exit 0 if files.empty?

system("bundle", "exec", "rubocop", "--config", CONFIG, NO_SHARED_SERVER, *files)
exit $?.exitstatus
