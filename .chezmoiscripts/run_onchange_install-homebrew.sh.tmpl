{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Install Homebrew packages from Brewfile

set -e

echo "Installing Homebrew packages..."

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
  echo "Homebrew not found. Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Homebrew 7 refuses to load formulae from untrusted third-party taps, and validates them at TAP
# time — so an untrusted tap fails the tap itself, and `brew bundle` dies on that line. Trust has
# to come first. (payaus's puppet manifest gets this backwards and cannot install puma-dev on a
# fresh machine as a result.) `brew trust --tap` on an untapped name is fine; it records intent.
brew trust --tap PeonPing/tap

# Install packages from Brewfile
cd "{{ .chezmoi.sourceDir }}"
brew bundle

echo "Homebrew package installation complete"
{{ end -}}
