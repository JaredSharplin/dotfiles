{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Runtimes and the gems that live outside any project bundle.
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# Bash, not Ruby: this is what installs Ruby.

set -e

command -v mise >/dev/null 2>&1 || { echo "mise not installed — skipping runtimes"; exit 0; }

mise install

# standardrb lints this repo; ruby-lsp backs nvim's Ruby LSP. Global on purpose — a project's
# bundle supplies its own rubocop.
for gem_name in standard ruby-lsp; do
  mise exec -- gem list -i "^${gem_name}$" >/dev/null 2>&1 || mise exec -- gem install "${gem_name}"
done

echo "Runtimes ready"
{{ end -}}
