    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jaredsharplin/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "core@tanda-plugins": true,
    "developer-tooling@tanda-plugins": true,
    "exhalekit@tanda-plugins": true
  },
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "extraKnownMarketplaces": {
    "tanda-plugins": {
      "source": {
        "source": "github",
        "repo": "TandaHQ/claude-plugins"
      }
    }
